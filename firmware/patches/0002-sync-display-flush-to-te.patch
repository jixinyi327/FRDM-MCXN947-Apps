+#define DEMO_TE_WAIT_TIMEOUT_US 25000U
+#define DEMO_TE_POLL_INTERVAL_US 10U
+
+/*
+ * Wait for the next complete TE pulse. If TE is already high, first wait for
+ * it to return low, then wait for the next rising edge.
+ */
+static bool DEMO_WaitForTE(void)
+{
+    uint32_t elapsedUs = 0U;
+
+    while ((0U != GPIO_PinRead(BOARD_LCD_TE_GPIO, BOARD_LCD_TE_PIN)) &&
+           (elapsedUs < DEMO_TE_WAIT_TIMEOUT_US))
+    {
+        SDK_DelayAtLeastUs(DEMO_TE_POLL_INTERVAL_US, SDK_DEVICE_MAXIMUM_CPU_CLOCK_FREQUENCY);
+        elapsedUs += DEMO_TE_POLL_INTERVAL_US;
+    }
+
+    while ((0U == GPIO_PinRead(BOARD_LCD_TE_GPIO, BOARD_LCD_TE_PIN)) &&
+           (elapsedUs < DEMO_TE_WAIT_TIMEOUT_US))
+    {
+        SDK_DelayAtLeastUs(DEMO_TE_POLL_INTERVAL_US, SDK_DEVICE_MAXIMUM_CPU_CLOCK_FREQUENCY);
+        elapsedUs += DEMO_TE_POLL_INTERVAL_US;
+    }
+
+    return elapsedUs < DEMO_TE_WAIT_TIMEOUT_US;
+}
